<svg width="400" height="300" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="maizeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FFA726;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#FF8F00;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="100%" height="100%" fill="url(#maizeGrad)"/>
  <text x="50%" y="40%" text-anchor="middle" dy=".3em" fill="white" font-size="28" font-family="Arial" font-weight="bold">Maize Seeds</text>
  <text x="50%" y="60%" text-anchor="middle" dy=".3em" fill="white" font-size="16" font-family="Arial">High-yielding hybrid varieties</text>
  <text x="50%" y="75%" text-anchor="middle" dy=".3em" fill="white" font-size="14" font-family="Arial">15 Varieties • 5 Categories</text>
</svg>
