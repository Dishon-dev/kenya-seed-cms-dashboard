# API Configuration
# This must match the variable name the app actually reads
# (REACT_APP_API_BASE) - a previous version of this file incorrectly used
# REACT_APP_API_URL, which nothing in the codebase reads.
REACT_APP_API_BASE=http://localhost:5001

# For production, set this to your actual API server URL:
# REACT_APP_API_BASE=https://api.kenyaseed.co.ke
